# ═══════════════════════════════════════════════════════════════════
# ATS Optimizer - Backend Environment Configuration Example
# ═══════════════════════════════════════════════════════════════════

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
MONGO_URI=mongodb://localhost:27017/ats_optimizer
# OR use MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/ats_optimizer?retryWrites=true&w=majority

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# OpenAI API Configuration
OPENAI_API_KEY=sk-your_openai_api_key_here

# Environment Logging
DEBUG=false
